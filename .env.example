# Teamleader SDK — environment variables
#
# Every variable config/teamleader.php reads. Only the first three are
# required; the rest show their default.

# --- Credentials (the `default` connection) ---------------------------------
# From your integration at https://marketplace.teamleader.eu/
TEAMLEADER_CLIENT_ID=
TEAMLEADER_CLIENT_SECRET=
TEAMLEADER_REDIRECT_URI=https://your-app.test/teamleader/callback

# Refuse an OAuth callback that connects any other Teamleader account
# TEAMLEADER_EXPECTED_ACCOUNT_ID=

# Connection used when none is named (see 'connections' in the config file,
# or `php artisan teamleader:connections:add`)
# TEAMLEADER_CONNECTION=default

# --- API --------------------------------------------------------------------
# TEAMLEADER_API_VERSION=2023-09-26
# TEAMLEADER_BASE_URL=https://api.focus.teamleader.eu
# TEAMLEADER_AUTH_URL=https://focus.teamleader.eu
# TEAMLEADER_API_TIMEOUT=30
# TEAMLEADER_API_CONNECT_TIMEOUT=10
# TEAMLEADER_API_READ_TIMEOUT=25
# TEAMLEADER_API_RETRY_ATTEMPTS=3
# TEAMLEADER_API_RETRY_DELAY=1000

# --- Errors -----------------------------------------------------------------
# true: failed requests throw (the default since v3.0)
# false: failures come back as arrays with error => true, as in v2.x
# TEAMLEADER_THROW_EXCEPTIONS=true

# --- Rate limiting (needs Redis) --------------------------------------------
# TEAMLEADER_RATE_LIMITING_ENABLED=true
# TEAMLEADER_RATE_LIMIT_REDIS_CONNECTION=default
# Raise to 65000 for long CLI jobs that may wait out a full window
# TEAMLEADER_RATE_LIMIT_MAX_WAIT_MS=5000

# --- Token renewal (needs the Laravel scheduler) ----------------------------
# TEAMLEADER_TOKENS_AUTO_REFRESH=true
# TEAMLEADER_TOKENS_REFRESH_BEFORE=1800

# --- Logging ----------------------------------------------------------------
# A channel from config/logging.php; unset uses your default channel
# TEAMLEADER_LOG_CHANNEL=
# Request / response bodies at debug level — they hold customer data
# TEAMLEADER_LOG_REQUESTS=false
# TEAMLEADER_LOG_RESPONSES=false

# --- Boot -------------------------------------------------------------------
# TEAMLEADER_VALIDATE_ON_BOOT=false

# --- Your own defaults (config/teamleader.php) ------------------------------
# TEAMLEADER_DEFAULT_CURRENCY=EUR
# TEAMLEADER_DEFAULT_COUNTRY=BE
